{
  "name": "Ptero MC Control Kit",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "forwardPorts": [
    8080,
    25565
  ],
  "portsAttributes": {
    "8080": {
      "label": "Panel web UI",
      "onAutoForward": "notify",
      "visibility": "private"
    },
    "25565": {
      "label": "Minecraft Java",
      "onAutoForward": "notify",
      "visibility": "private"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python"
      ]
    }
  },
  "postCreateCommand": "python -m unittest discover -s tests -v"
}
